:root {
  /* ==== 立绘定位（改立绘大小/位置只动这三行）==== */
  --portrait-right: 15%;
  --portrait-bottom: -43%;
  --portrait-height: 132%;
  /* ==== 立绘光照（暖=右上角台灯，冷=左上月光）==== */
  --warm-light: rgba(255, 170, 80, 0.32);
  --cool-light: rgba(80, 130, 230, 0.16);
  --ground-shadow: rgba(0, 0, 0, 0.35);
  /* ==== 环境光叠加层 ==== */
  --ambient-warm: rgba(255, 190, 120, 0.34);
  --ambient-cool: rgba(90, 140, 230, 0.22);
  --ambient-floor: rgba(130, 80, 35, 0.28);
  /* ==== 对话窗 ==== */
  --panel-bg: rgba(12, 11, 19, 0.88);
  --panel-bg-top: rgba(12, 11, 19, 0.66);
}

*{box-sizing:border-box}html,body,#root{margin:0;width:100%;height:100%;overflow:hidden;font-family:"Microsoft YaHei",sans-serif}body{background:#160f19;color:#fff}.stage{position:fixed;inset:0;overflow:hidden;cursor:pointer}.background{position:absolute;inset:0;background-size:cover;background-position:center 42%;background-color:#160f19;transition:opacity .4s ease}.background:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,14,22,.2),rgba(10,14,22,.08) 52%,rgba(10,14,22,.22)),linear-gradient(to top,rgba(10,14,22,.6),rgba(10,14,22,.08) 58%,rgba(10,14,22,.3))}.dialogue-box{position:absolute;left:0;right:0;bottom:0;min-height:145px;padding:20px 36px;background:linear-gradient(to top,var(--panel-bg),var(--panel-bg-top));backdrop-filter:none;z-index:4;cursor:pointer}.speaker-name{color:#e4b08f;font-weight:700;font-size:18px;margin-bottom:10px}.dialogue-text{font-size:21px;line-height:1.8;text-shadow:0 1px 4px #000;min-height:44px}.assistant-reply-gradient{color:#f2dcc4;background-image:none;background-repeat:no-repeat;text-shadow:0 2px 8px rgba(0,0,0,.88),0 0 1px rgba(255,255,255,.65)}@supports (-webkit-background-clip:text) or (background-clip:text){.assistant-reply-gradient{background-image:linear-gradient(110deg,#f7d9b8 0%,#e8b48c 42%,#dfa379 68%,#f7d9b8 100%);background-size:240% 100%;background-position:0% 50%;animation:assistant-reply-gradient-shift 8s ease-in-out infinite;-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}}.dialogue-composer{display:flex;gap:10px;margin-top:12px;max-width:900px}.dialogue-composer textarea{flex:1;resize:none;min-height:44px;max-height:100px;background:rgba(10,10,18,.45);border:1px solid rgba(228,176,143,.45);border-radius:5px;color:#fff;padding:10px 12px;font:inherit;outline:none}.dialogue-composer textarea:focus{border-color:#e4b08f}.dialogue-composer button{border:0;border-radius:5px;background:#dfaa8d;color:#24131e;font-weight:700;padding:0 18px;cursor:pointer}.dialogue-composer button:disabled{opacity:.5}.dialogue-actions{display:flex;justify-content:space-between;align-items:center;max-width:900px;margin-top:8px;color:#bda8b0;font-size:11px}.dialogue-actions button{border:0;background:transparent;color:#e4b08f;font-size:11px;cursor:pointer}

/* 方案B：闲置时的「点击开始输入」胶囊条 */
.idle-bar{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:auto;padding-top:16px;max-width:900px}
.idle-bar button{border:1px solid rgba(228,176,143,.35);background:rgba(10,10,18,.35);color:#d9b79e;font-size:12px;padding:6px 14px;border-radius:999px;cursor:pointer;transition:background .15s,color .15s,border-color .15s}
.idle-bar button:hover{background:rgba(228,176,143,.15);color:#f2c9ae;border-color:rgba(228,176,143,.7)}
.idle-bar button:disabled{opacity:.45;cursor:wait}
.idle-open-composer{color:#f2c9ae;font-weight:700}.dialogue-error{color:#ffd1d6;font-size:12px;margin-top:7px}.dialogue-error button{margin-left:10px;border:0;background:transparent;color:#ffd1d6;cursor:pointer}
.dialogue-composer{position:relative;display:flex;flex-wrap:wrap;align-items:flex-end}.dialogue-composer textarea{min-width:0}.dialogue-composer-controls{display:flex;align-items:stretch;gap:8px}.chat-attachment-button{width:42px;padding:0!important;font-size:22px;line-height:1}.chat-attachment-preview{display:flex;align-items:center;gap:8px;flex:0 0 100%;min-width:0;margin-top:8px;padding:6px 8px;border:1px solid rgba(228,176,143,.3);background:rgba(10,10,18,.35);border-radius:5px}.chat-attachment-preview img{width:52px;height:52px;object-fit:cover;border-radius:4px;background:#18151d}.chat-attachment-meta{display:grid;min-width:0;gap:3px}.chat-attachment-meta strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#f2c9ae;font-size:12px}.chat-attachment-meta small{color:#bda8b0;font-size:11px}.chat-attachment-remove{margin-left:auto!important;padding:0 8px!important;background:transparent!important;color:#f4c3c9!important;font-size:20px;line-height:1}
@media (max-width: 700px) {.dialogue-composer textarea{flex-basis:100%}.dialogue-composer-controls{width:100%;justify-content:flex-end}.dialogue-composer-controls button[type="submit"]{min-height:38px}.chat-attachment-preview{max-width:100%;box-sizing:border-box}}
.location-sharing.active{border-color:rgba(126, 231, 135, .75);color:#b8f5c0;background:rgba(64, 125, 72, .28)}

/* 状态指示器 */
.status-indicator {
  position: absolute;
  top: 12px;
  right: 12px;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  background: rgba(0, 0, 0, 0.42);
  border: 0;
  border-radius: 16px;
  cursor: pointer;
  transition: background 0.2s;
  font: inherit;
  font-size: 11px;
  opacity: .82;
  z-index: 10;
}

.status-indicator:hover {
  background: rgba(0, 0, 0, 0.8);
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

.status-text {
  color: white;
  font-weight: 500;
}

.status-time {
  color: rgba(255, 255, 255, 0.6);
  font-size: 11px;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

/* 确认对话框 */
.confirmation-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.confirmation-dialog {
  background: #1a1a2e;
  border: 2px solid #c084fc;
  border-radius: 12px;
  padding: 24px;
  max-width: 500px;
  width: 90%;
  box-shadow: 0 8px 32px rgba(192, 132, 252, 0.3);
}

.confirmation-dialog h3 {
  margin: 0 0 16px 0;
  color: #c084fc;
  font-size: 18px;
}

.confirmation-details {
  margin-bottom: 20px;
  color: #e5e7eb;
  font-size: 14px;
}

.confirmation-details pre {
  background: rgba(0, 0, 0, 0.3);
  padding: 12px;
  border-radius: 6px;
  overflow-x: auto;
  font-size: 12px;
  margin-top: 8px;
}

.confirmation-actions {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
}

.confirmation-actions button {
  padding: 10px 20px;
  border: none;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-confirm {
  background: #4ade80;
  color: #1a1a2e;
}

.btn-confirm:hover:not(:disabled) {
  background: #22c55e;
  transform: translateY(-1px);
}

.btn-reject {
  background: #f87171;
  color: white;
}

.btn-reject:hover:not(:disabled) {
  background: #ef4444;
  transform: translateY(-1px);
}

.confirmation-actions button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.confirmation-error {
  color: #f87171;
  font-size: 13px;
  margin: 0 0 12px 0;
}

/* 打字光标 */
.typing-cursor {
  display: inline-block;
  width: 2px;
  height: 1.2em;
  background: #e4b08f;
  margin-left: 3px;
  animation: cursor-blink 0.8s step-end infinite;
}

@keyframes cursor-blink {
  50% { opacity: 0; }
}

.dialogue-text {
  position: relative;
}

/* 打字中时添加微妙的提示 */
.dialogue-box:hover .typing-cursor {
  background: #f2c9ae;
}

/* 立绘定位：避开月亮、台灯和桌面摆件，并为聊天面板预留落脚空间。 */
.portrait-container {
  position: absolute;
  inset: 0;
  z-index: 3;
}

.portrait {
  position: absolute;
  right: var(--portrait-right);
  bottom: var(--portrait-bottom);
  height: var(--portrait-height);
  object-fit: contain;
  max-width: none;
  object-position: bottom center;
  filter:
    brightness(0.80)
    sepia(0.16)
    drop-shadow(20px 0 38px var(--warm-light))
    drop-shadow(-14px 0 26px var(--cool-light))
    drop-shadow(0 14px 16px var(--ground-shadow));
}


/* 很淡的背景色叠加：让场景的暖台灯 + 蓝月光也"染"到角色上，消除贴图感 */
.portrait-container::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 145px;
  left: 48%;
  z-index: 5;
  background:
    radial-gradient(100% 70% at 82% 6%, var(--ambient-warm), transparent 55%),
    radial-gradient(90% 60% at 6% 12%, var(--ambient-cool), transparent 55%),
    linear-gradient(to top, var(--ambient-floor), transparent 45%);
  mix-blend-mode: soft-light;
  pointer-events: none;
}

/* 纯人物/背景预览：提示 F2 恢复 */
.ui-hidden-hint{position:fixed;left:12px;bottom:10px;font-size:11px;color:rgba(255,255,255,.4);pointer-events:none;z-index:5}

/* 回退本次视觉实验：恢复原构图，取消会露出边界的环境框层。 */
:root {
  --portrait-right: 15%;
  --portrait-bottom: -43%;
  --portrait-height: 132%;
  --warm-light: rgba(255, 170, 80, 0.32);
  --cool-light: rgba(80, 130, 230, 0.16);
  --ground-shadow: rgba(0, 0, 0, 0.35);
  --ambient-warm: rgba(255, 190, 120, 0.34);
  --ambient-cool: rgba(90, 140, 230, 0.22);
  --ambient-floor: rgba(130, 80, 35, 0.28);
  --panel-bg: rgba(12, 11, 19, 0.88);
  --panel-bg-top: rgba(12, 11, 19, 0.66);
}

.background { background-position: center; }
.dialogue-box { min-height: 215px; padding: 28px 40px; display: flex; flex-direction: column; }
.portrait-container::before { display: none; }
.portrait {
  right: var(--portrait-right);
  bottom: var(--portrait-bottom);
  height: var(--portrait-height);
  filter:
    brightness(0.85)
    sepia(0.22)
    drop-shadow(28px 0 48px var(--warm-light))
    drop-shadow(-18px 0 32px var(--cool-light))
    drop-shadow(0 18px 20px var(--ground-shadow));
}
.status-indicator { padding: 6px 12px; background: rgba(0, 0, 0, 0.6); font-size: 12px; opacity: 1; }

/* 提高窗户特效的可感知度：仍保持软边，但首屏即可看到变化。 */
.background::before {
  background: radial-gradient(ellipse 27% 31% at 44% 13%, rgba(165, 205, 255, .2), transparent 70%);
  opacity: .72;
  animation-name: moonlight-drift-visible;
  animation-duration: 8s;
}

.stage::before {
  background: linear-gradient(112deg, transparent 41%, rgba(255, 240, 220, .14) 49%, transparent 57%);
  background-size: 220% 100%;
  animation-name: window-reflection-visible;
  animation-duration: 7s;
  animation-delay: .45s;
}

@keyframes moonlight-drift-visible {
  0%, 100% { opacity: .5; }
  50% { opacity: .9; }
}

@keyframes window-reflection-visible {
  0%, 12% { opacity: 0; background-position: 130% 0; }
  25%, 62% { opacity: .85; background-position: 30% 0; }
  75%, 100% { opacity: 0; background-position: -20% 0; }
}

/* 白天场景：人物保持原版立绘，不加滤镜 */
.scene-day .portrait {
  filter: none;
}

/* 白天影子：放在父容器上常驻，切换表情时立绘淡入淡出也不闪 */
.scene-day .portrait-container {
  filter: drop-shadow(16px 12px 16px rgba(0, 0, 0, 0.26))
          drop-shadow(0 10px 12px rgba(0, 0, 0, 0.14));
}

/* 白天场景：去掉环境光染色层，从零重新设计 */
.scene-day .portrait-container::before {
  display: none;
}

/* 白天场景：去掉夜景深色遮罩与月光/玻璃特效，背景保持原始明亮 */
.scene-day .background::after { opacity: 0; }
.scene-day .background::before { display: none; }
.scene-day .stage::before { display: none; }

/* 窗外月光：无边界的柔和亮度变化，模拟云层缓慢经过月亮。 */
.background::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 24% 28% at 44% 13%, rgba(155, 195, 255, .14), transparent 72%);
  opacity: .5;
  mix-blend-mode: screen;
  animation: moonlight-drift 11s ease-in-out infinite;
  pointer-events: none;
}

/* 玻璃反光：只在窗户区域柔和扫过，不产生矩形边界。 */
.stage::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(112deg, transparent 43%, rgba(255, 240, 220, .09) 49%, transparent 55%);
  background-size: 220% 100%;
  opacity: 0;
  mix-blend-mode: screen;
  pointer-events: none;
  mask-image: radial-gradient(ellipse 32% 37% at 47% 26%, #000 0%, rgba(0, 0, 0, .86) 42%, transparent 76%);
  -webkit-mask-image: radial-gradient(ellipse 32% 37% at 47% 26%, #000 0%, rgba(0, 0, 0, .86) 42%, transparent 76%);
  animation: window-reflection 10s ease-in-out 1.5s infinite;
}

@keyframes moonlight-drift {
  0%, 100% { opacity: .35; }
  50% { opacity: .65; }
}

@keyframes window-reflection {
  0%, 18% { opacity: 0; background-position: 130% 0; }
  30%, 58% { opacity: .55; background-position: 30% 0; }
  70%, 100% { opacity: 0; background-position: -20% 0; }
}

/* 最终生效的窗户增强参数，覆盖前面保留的基础规则。 */
.background::before {
  background: radial-gradient(ellipse 27% 31% at 44% 13%, rgba(165, 205, 255, .2), transparent 70%);
  opacity: .72;
  animation: moonlight-drift-visible 8s ease-in-out infinite;
}

.stage::before {
  background: linear-gradient(112deg, transparent 41%, rgba(255, 240, 220, .14) 49%, transparent 57%);
  background-size: 220% 100%;
  animation: window-reflection-visible 7s ease-in-out .45s infinite;
}

@keyframes portrait-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes portrait-fade-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

.portrait { pointer-events: none; }
.portrait-previous { z-index: 1; animation: portrait-fade-out .22s ease-in-out forwards; }
.portrait-current { z-index: 2; animation: portrait-fade-in .22s ease-in-out both; }

/* 交叉淡出期间只对合成后的角色做一次光影，避免两张立绘的阴影叠成移动光圈。 */
.portrait-container {
  filter:
    brightness(0.85)
    sepia(0.22)
    drop-shadow(28px 0 48px var(--warm-light))
    drop-shadow(-18px 0 32px var(--cool-light))
    drop-shadow(0 18px 20px var(--ground-shadow));
}

.portrait { filter: none; }

/* ===== 手动立绘切换面板 ===== */
.portrait-switcher {
  position: absolute;
  right: 18px;
  top: 18px;
  z-index: 30;
}

.portrait-switcher-toggle {
  width: 42px;
  height: 42px;
  border: 1px solid rgba(228,176,143,.4);
  border-radius: 999px;
  background: rgba(10,10,18,.55);
  color: #e8c4a8;
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
  transition: background .15s, border-color .15s, transform .15s;
  backdrop-filter: blur(4px);
}

.portrait-switcher-toggle:hover {
  background: rgba(228,176,143,.18);
  border-color: rgba(228,176,143,.75);
  transform: scale(1.05);
}

.portrait-switcher-panel {
  position: absolute;
  top: 50px;
  right: 0;
  width: 292px;
  max-height: min(70vh, 560px);
  overflow-y: auto;
  padding: 12px;
  border: 1px solid rgba(228,176,143,.35);
  border-radius: 14px;
  background: rgba(12,11,16,.92);
  box-shadow: 0 12px 32px rgba(0,0,0,.5);
  backdrop-filter: blur(8px);
}

.portrait-switcher-title {
  font-size: 12px;
  color: #d9b79e;
  letter-spacing: 2px;
  margin-bottom: 10px;
  text-align: center;
}

.portrait-switcher-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.portrait-switcher-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 6px 4px 5px;
  border: 1px solid rgba(228,176,143,.22);
  border-radius: 10px;
  background: rgba(228,176,143,.06);
  cursor: pointer;
  transition: background .15s, border-color .15s, transform .12s;
}

.portrait-switcher-item:hover {
  background: rgba(228,176,143,.16);
  border-color: rgba(228,176,143,.6);
  transform: translateY(-1px);
}

.portrait-switcher-item img {
  width: 100%;
  height: 74px;
  object-fit: contain;
  object-position: top center;
  pointer-events: none;
}

.portrait-switcher-item span {
  font-size: 12px;
  color: #e8c4a8;
}

.portrait-switcher-item small {
  position: absolute;
  top: 4px;
  right: 6px;
  font-size: 10px;
  color: rgba(217,183,158,.6);
}

/* ===== 导航栏样式 ===== */
.app-container {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.app-navigation {
  display: flex;
  gap: 1.5rem;
  padding: 1.5rem 2rem;
  background: transparent;
  border-bottom: none;
  z-index: 100;
}

.nav-tab {
  padding: 0.8rem 2rem;
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 6px;
  color: rgba(255, 255, 255, 0.7);
  cursor: pointer;
  transition: all 0.2s;
  font-family: inherit;
  font-size: 16px;
  font-weight: 500;
}

.nav-tab:hover {
  background: rgba(0, 0, 0, 0.45);
  color: rgba(255, 255, 255, 0.9);
  border-color: rgba(255, 255, 255, 0.2);
}

.nav-tab.active {
  background: rgba(139, 92, 246, 0.25);
  border-color: rgba(139, 92, 246, 0.6);
  color: #fff;
}

/* ===== 设置页面样式 ===== */
.settings-page {
  padding: 2rem;
  max-width: 800px;
  margin: 0 auto;
  color: #fff;
  overflow-y: auto;
  flex: 1;
  /* 自定义滚动条样式 */
  scrollbar-width: thin;
  scrollbar-color: rgba(139, 92, 246, 0.5) rgba(255, 255, 255, 0.1);
}

/* Webkit 浏览器滚动条样式 */
.settings-page::-webkit-scrollbar {
  width: 8px;
}

.settings-page::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 4px;
}

.settings-page::-webkit-scrollbar-thumb {
  background: rgba(139, 92, 246, 0.5);
  border-radius: 4px;
}

.settings-page::-webkit-scrollbar-thumb:hover {
  background: rgba(139, 92, 246, 0.7);
}

.settings-page h1 {
  margin-top: 0;
  margin-bottom: 2rem;
  font-size: 1.8rem;
  color: rgba(228, 176, 143, 1);
}

.settings-section {
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
}

.settings-section h2 {
  margin-top: 0;
  margin-bottom: 1rem;
  font-size: 1.2rem;
  color: rgba(139, 92, 246, 1);
}

.work-page { max-width: 1100px; }
.work-toolbar { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
.work-toolbar > div:first-child { margin-right: auto; display: grid; gap: .25rem; }
.work-muted { color: rgba(255,255,255,.55); }
.work-mode-buttons { display: flex; gap: .5rem; flex-wrap: wrap; }
.work-toolbar select { margin-left: .5rem; padding: .45rem; background: #241e35; color: #fff; border: 1px solid rgba(255,255,255,.2); border-radius: 4px; }
.work-volume { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.work-volume h2 { margin-bottom: .3rem; }
.work-capture { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.work-capture h2 { margin-bottom: .3rem; }
.work-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem; }
.work-path { word-break: break-all; color: rgba(255,255,255,.85); }
.work-workspace-input { width: 100%; box-sizing: border-box; padding: .6rem; margin-bottom: .7rem; background: rgba(0,0,0,.25); color: #fff; border: 1px solid rgba(255,255,255,.2); border-radius: 4px; }
.work-run { display: grid; grid-template-columns: auto auto 1fr auto; gap: .6rem; align-items: center; padding: .7rem 0; border-bottom: 1px solid rgba(255,255,255,.08); }
.work-run small { color: rgba(255,255,255,.55); }
.work-event { border-top: 1px solid rgba(255,255,255,.08); padding: .9rem 0; }
.work-event summary { display: grid; grid-template-columns: 5.25rem minmax(0, 1fr); gap: 1rem; align-items: start; line-height: 1.45; cursor: pointer; list-style: none; }
.work-event summary::-webkit-details-marker { display: none; }
.work-event summary time { color: rgba(255,255,255,.5); font-size: .82rem; padding-top: .18rem; }
.work-event-content { display: grid; min-width: 0; gap: .35rem; }
.work-event-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: .65rem; }
.work-event-heading strong { color: rgba(255,255,255,.95); font-size: .96rem; }
.work-event-status { font-size: .78rem; font-style: normal; color: #9ae6b4; }
.work-event-status.status-failed, .work-event-status.status-timeout { color: #fca5a5; }
.work-event-status.status-executing, .work-event-status.status-started, .work-event-status.status-repair_started, .work-event-status.status-verifying { color: #fcd34d; }
.work-event-command-summary { min-width: 0; color: rgba(255,255,255,.56); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .78rem; overflow-wrap: anywhere; }
.work-event-details { display: grid; gap: .8rem; margin: .95rem 0 0 6.25rem; padding: .9rem; border-left: 2px solid rgba(139,92,246,.4); background: rgba(0,0,0,.16); }
.work-event-details > div { display: grid; gap: .35rem; }
.work-event-details > div > span { color: rgba(255,255,255,.55); font-size: .78rem; }
.work-event-details code { display: block; padding: .65rem; color: rgba(255,255,255,.85); background: rgba(0,0,0,.28); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .8rem; line-height: 1.55; overflow-wrap: anywhere; white-space: pre-wrap; }
.work-event-meta { display: flex !important; flex-wrap: wrap; gap: .5rem 1rem; color: rgba(255,255,255,.62); font-size: .8rem; }
.work-event-details pre { max-height: 16rem; margin: 0; padding: .65rem; overflow: auto; white-space: pre-wrap; color: rgba(255,255,255,.78); background: rgba(0,0,0,.28); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .8rem; line-height: 1.55; }
.work-artifact { margin-top: 12px; }
.work-screenshot { display: block; width: min(100%, 720px); max-height: 420px; object-fit: contain; object-position: left top; border: 1px solid rgba(255,255,255,.2); background: #f6f7f9; }
.work-submit-row { display: flex; gap: .65rem; align-items: center; }
.work-submit-row input { flex: 1; min-width: 0; padding: .6rem; background: rgba(0,0,0,.25); color: #fff; border: 1px solid rgba(255,255,255,.2); border-radius: 4px; }
.work-task-select { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .25rem .75rem; min-width: 0; padding: 0; border: 0; background: transparent; color: inherit; text-align: left; cursor: pointer; }
.work-task-select strong { overflow-wrap: anywhere; }
.work-task-select small { grid-column: 1 / -1; color: rgba(255,255,255,.55); }
.work-run-selected { border-left: 2px solid #a78bfa; padding-left: .55rem; }
.work-task-detail-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
.work-approval { display: grid; gap: .6rem; margin: .75rem 0; padding: .8rem; border-left: 2px solid #fbbf24; background: rgba(251,191,36,.08); }
.work-approval > div { display: flex; gap: .5rem; flex-wrap: wrap; }
.work-approval pre, .work-attempt pre { max-height: 16rem; overflow: auto; white-space: pre-wrap; font-size: .78rem; }
.work-task-events { display: grid; gap: .45rem; max-height: 20rem; overflow: auto; }
.work-task-events > div { display: grid; grid-template-columns: 5rem 8rem minmax(0, 1fr); gap: .6rem; align-items: start; font-size: .8rem; }
.work-task-events time { color: rgba(255,255,255,.5); }
.work-task-events code { overflow-wrap: anywhere; color: rgba(255,255,255,.7); }
.work-plan textarea { resize: vertical; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .82rem; line-height: 1.5; }
.work-plan-actions { display: flex; gap: .5rem; flex-wrap: wrap; }
.work-plan-steps { display: grid; gap: .75rem; margin: 1rem 0 0; padding-left: 1.4rem; }
.work-plan-step { padding: .75rem .9rem; border-left: 2px solid rgba(255,255,255,.18); background: rgba(0,0,0,.16); }
.work-plan-step.tone-ok { border-left-color: #6ee7b7; }
.work-plan-step.tone-busy { border-left-color: #a78bfa; }
.work-plan-step.tone-warn { border-left-color: #fbbf24; }
.work-plan-step.tone-bad { border-left-color: #fca5a5; }
.work-plan-step-head { display: flex; align-items: baseline; justify-content: space-between; gap: .75rem; }
.work-plan-step-head strong { overflow-wrap: anywhere; }
.work-plan-step > p { margin: .35rem 0 .55rem; font-size: .82rem; }
.work-plan-error { color: #fca5a5; overflow-wrap: anywhere; }
.work-event-status.status-running, .work-event-status.status-ready, .work-event-status.status-queued { color: #c4b5fd; }
.work-event-status.status-waiting_approval, .work-event-status.status-interrupted { color: #fcd34d; }
.work-event-status.status-failed, .work-event-status.status-blocked, .work-event-status.status-cancelled { color: #fca5a5; }
.work-event-status.status-pending { color: rgba(255,255,255,.62); }
@media (max-width: 700px) { .work-grid { grid-template-columns: 1fr; } .work-event summary { grid-template-columns: 1fr; gap: .25rem; } .work-event-details { margin-left: 0; } .work-run { grid-template-columns: 1fr auto; } .work-run small { grid-column: 1 / -1; } }

.conversation-settings-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.conversation-settings-heading h2 {
  margin-bottom: 0;
}

.conversation-filter {
  display: flex;
  gap: 0.5rem;
  margin: 1.1rem 0 0.75rem;
}

.conversation-filter button,
.conversation-row-actions button {
  min-height: 32px;
  padding: 0.35rem 0.7rem;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.82);
  cursor: pointer;
  font: inherit;
  font-size: 0.84rem;
  transition: background 0.15s, border-color 0.15s, color 0.15s;
}

.conversation-filter button:hover:not(:disabled),
.conversation-row-actions button:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.11);
  border-color: rgba(255, 255, 255, 0.28);
  color: #fff;
}

.conversation-filter button.active {
  background: rgba(139, 92, 246, 0.22);
  border-color: rgba(139, 92, 246, 0.58);
  color: #fff;
}

.conversation-filter button:disabled,
.conversation-row-actions button:disabled {
  cursor: not-allowed;
  opacity: 0.46;
}

.conversation-list {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.conversation-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 1rem;
  align-items: center;
  min-height: 64px;
  padding: 0.75rem 0.2rem 0.75rem 0.85rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.conversation-row.active {
  box-shadow: inset 3px 0 0 rgba(228, 176, 143, 0.88);
}

.conversation-summary {
  display: grid;
  min-width: 0;
  gap: 0.25rem;
}

.conversation-summary strong {
  overflow: hidden;
  color: rgba(255, 255, 255, 0.94);
  font-size: 0.94rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation-summary span {
  color: rgba(255, 255, 255, 0.56);
  font-size: 0.78rem;
}

.conversation-row-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 0.45rem;
}

.conversation-row-actions .conversation-delete {
  border-color: rgba(239, 68, 68, 0.34);
  color: #fca5a5;
}

.conversation-row-actions .conversation-delete:hover:not(:disabled) {
  background: rgba(239, 68, 68, 0.17);
  border-color: rgba(239, 68, 68, 0.58);
  color: #fecaca;
}

.conversation-error {
  margin: 0.75rem 0;
  color: #fca5a5;
  font-size: 0.88rem;
}

@media (max-width: 600px) {
  .conversation-settings-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .conversation-row {
    grid-template-columns: 1fr;
    gap: 0.65rem;
  }

  .conversation-row-actions {
    justify-content: flex-start;
  }
}

.settings-field {
  margin-bottom: 1rem;
}

.settings-field label {
  display: block;
  margin-bottom: 0.3rem;
  font-size: 0.9rem;
  opacity: 0.8;
}

.settings-field input,
.settings-field textarea {
  width: 100%;
  padding: 0.75rem 1rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 6px;
  color: #fff;
  font-family: inherit;
  font-size: 15px;
  line-height: 1.5;
}

.settings-field input:focus,
.settings-field textarea:focus {
  outline: none;
  border-color: rgba(139, 92, 246, 0.8);
}

.settings-field input::placeholder {
  opacity: 0.5;
  color: #bbb;
}

/* 场景开关：checkbox 需要覆盖 .settings-field input 的整宽与深色输入框样式 */
.settings-checkbox-field label {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.4rem;
  font-size: 0.95rem;
  opacity: 1;
  cursor: pointer;
  user-select: none;
}

.settings-checkbox-field input[type="checkbox"] {
  width: auto;
  flex: none;
  margin: 0;
  padding: 0;
  accent-color: #e4b08f;
  width: 16px;
  height: 16px;
  cursor: pointer;
}

.settings-hint {
  margin: 0;
  padding-left: 1.6rem;
  font-size: 0.82rem;
  line-height: 1.6;
  opacity: 0.6;
}

.settings-actions {
  display: flex;
  gap: 1rem;
  align-items: center;
  margin-top: 2rem;
  flex-wrap: wrap;
}

.btn-save {
  padding: 0.6rem 1.5rem;
  background: rgba(139, 92, 246, 0.8);
  border: none;
  border-radius: 4px;
  color: #fff;
  cursor: pointer;
  transition: background 0.2s;
  font-family: inherit;
  font-size: 14px;
  font-weight: 600;
}

.btn-save:hover {
  background: rgba(139, 92, 246, 1);
}

.btn-save:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.save-status {
  padding: 0.5rem 1rem;
  border-radius: 4px;
  font-size: 0.9rem;
}

.save-status.success {
  background: rgba(34, 197, 94, 0.2);
  border: 1px solid rgba(34, 197, 94, 0.5);
  color: rgb(34, 197, 94);
}

.save-status.error {
  background: rgba(239, 68, 68, 0.2);
  border: 1px solid rgba(239, 68, 68, 0.5);
  color: rgb(239, 68, 68);
}

.settings-loading {
  text-align: center;
  padding: 3rem;
  opacity: 0.6;
}

.registered-tools-list {
  display: grid;
  gap: 0.9rem;
}

.registered-tool-module {
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 6px;
  padding: 0.9rem;
}

.registered-tool-module-heading {
  display: flex;
  align-items: baseline;
  gap: 0.7rem;
  margin-bottom: 0.7rem;
}

.registered-tool-module-heading strong {
  color: rgba(228, 176, 143, 1);
}

.registered-tool-module-heading span,
.registered-tools-state,
.registered-tool-module p {
  margin: 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.9rem;
}

.registered-tools-state.error {
  color: rgb(239, 68, 68);
}

.diagnostic-overall {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.7rem;
  margin-bottom: 0.85rem;
}

.diagnostic-overall time {
  color: rgba(255, 255, 255, 0.55);
  font-size: 0.78rem;
}

.diagnostic-list {
  display: grid;
  gap: 0.6rem;
}

.diagnostic-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.55rem 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.diagnostic-row:last-child {
  border-bottom: 0;
}

.diagnostic-row strong {
  color: rgba(255, 255, 255, 0.9);
}

.diagnostic-row p {
  margin: 0.25rem 0 0;
  color: rgba(255, 255, 255, 0.62);
  font-size: 0.82rem;
  overflow-wrap: anywhere;
}

.diagnostic-status {
  flex: 0 0 auto;
  border-radius: 4px;
  padding: 0.2rem 0.5rem;
  font-size: 0.78rem;
  font-weight: 600;
}

.diagnostic-status-healthy {
  background: rgba(34, 197, 94, 0.18);
  color: rgb(134, 239, 172);
}

.diagnostic-status-degraded {
  background: rgba(251, 146, 60, 0.18);
  color: rgb(253, 186, 116);
}

.diagnostic-status-unhealthy {
  background: rgba(239, 68, 68, 0.18);
  color: rgb(252, 165, 165);
}

.diagnostic-status-unknown {
  background: rgba(148, 163, 184, 0.18);
  color: rgb(203, 213, 225);
}

.registered-tool-module ul {
  display: grid;
  gap: 0.65rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.registered-tool-module li {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: flex-start;
}

.module-dependencies {
  margin-bottom: 0.7rem;
}

.tool-statuses {
  display: flex;
  flex: 0 0 auto;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 0.35rem;
}

.tool-advertised-status {
  border-radius: 4px;
  padding: 0.2rem 0.45rem;
  background: rgba(148, 163, 184, 0.18);
  color: rgb(203, 213, 225);
  font-size: 0.8rem;
}

.tool-declared-status {
  border-radius: 4px;
  padding: 0.2rem 0.45rem;
  background: rgba(45, 212, 191, 0.16);
  color: rgb(153, 246, 228);
  font-size: 0.8rem;
}

.capability-checked-at {
  color: var(--text-muted);
  font-size: 0.78rem;
}

.registered-tool-module code {
  color: #fff;
  font-size: 0.9rem;
}

.registered-tool-module li p {
  margin-top: 0.25rem;
}

.tool-risk {
  flex: 0 0 auto;
  border-radius: 4px;
  padding: 0.2rem 0.45rem;
  background: rgba(34, 197, 94, 0.18);
  color: rgb(134, 239, 172);
  font-size: 0.8rem;
}

.tool-risk-high {
  background: rgba(239, 68, 68, 0.18);
  color: rgb(252, 165, 165);
}

.memory-page {
  max-width: 980px;
}

.memory-page-header {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: flex-start;
  margin-bottom: 1.25rem;
}

.memory-page h1 {
  margin-bottom: 0.35rem;
}

.memory-page-subtitle {
  margin: 0;
  color: rgba(255, 255, 255, 0.68);
  font-size: 0.95rem;
  line-height: 1.5;
}

.memory-page-meta {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.memory-badge {
  padding: 0.35rem 0.7rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.84);
  font-size: 0.82rem;
}

.memory-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  padding: 0.8rem 1rem;
  border-radius: 8px;
  margin-bottom: 1rem;
}

.memory-banner.error {
  background: rgba(239, 68, 68, 0.16);
  border: 1px solid rgba(239, 68, 68, 0.35);
  color: #fecaca;
}

.memory-banner button {
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.memory-summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.75rem;
}

.memory-summary-card {
  min-height: 96px;
  padding: 0.9rem 1rem;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.memory-summary-label {
  font-size: 0.84rem;
  color: rgba(255, 255, 255, 0.68);
}

.memory-summary-value {
  margin-top: 0.35rem;
  font-size: 1.8rem;
  font-weight: 700;
  color: #fff;
}

.memory-summary-detail {
  margin-top: 0.25rem;
  font-size: 0.82rem;
  color: rgba(255, 255, 255, 0.58);
}

.memory-status-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.75rem 1rem;
}

.memory-status-item {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: center;
  padding: 0.65rem 0.8rem;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.memory-status-label {
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.9rem;
}

.memory-status-value {
  padding: 0.25rem 0.55rem;
  border-radius: 999px;
  font-size: 0.82rem;
  border: 1px solid transparent;
  color: #fff;
}

.memory-status-value.ok {
  background: rgba(34, 197, 94, 0.16);
  border-color: rgba(34, 197, 94, 0.35);
}

.memory-status-value.degraded {
  background: rgba(245, 158, 11, 0.16);
  border-color: rgba(245, 158, 11, 0.35);
}

.memory-status-value.unavailable,
.memory-status-value.error {
  background: rgba(239, 68, 68, 0.16);
  border-color: rgba(239, 68, 68, 0.35);
}

.memory-status-mono {
  max-width: 58%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memory-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
  margin-top: 0.75rem;
}

.memory-chip {
  padding: 0.3rem 0.55rem;
  border-radius: 999px;
  background: rgba(139, 92, 246, 0.14);
  border: 1px solid rgba(139, 92, 246, 0.25);
  color: rgba(255, 255, 255, 0.84);
  font-size: 0.8rem;
}

.memory-muted {
  color: rgba(255, 255, 255, 0.56);
  font-size: 0.88rem;
}

.memory-record-list {
  display: grid;
  gap: 0.75rem;
}

.memory-record {
  padding: 0.9rem 1rem;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.memory-record-top {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: baseline;
}

.memory-record-content {
  font-size: 0.98rem;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.95);
  word-break: break-word;
}

.memory-record-time {
  flex: 0 0 auto;
  color: rgba(255, 255, 255, 0.48);
  font-size: 0.82rem;
}

.memory-record-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem 1rem;
  margin-top: 0.55rem;
  color: rgba(255, 255, 255, 0.6);
  font-size: 0.84rem;
}

.memory-record-source {
  margin-top: 0.55rem;
  color: rgba(255, 255, 255, 0.62);
  font-size: 0.84rem;
  line-height: 1.5;
  word-break: break-word;
}

.memory-empty {
  padding: 1.25rem;
  border-radius: 8px;
  border: 1px dashed rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.03);
}

.memory-empty-title {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.memory-empty-text {
  color: rgba(255, 255, 255, 0.6);
  font-size: 0.9rem;
  line-height: 1.5;
}

@keyframes assistant-reply-gradient-shift {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

@media (max-width: 900px) {
  .memory-page-header {
    flex-direction: column;
  }

  .memory-page-meta {
    justify-content: flex-start;
  }

  .memory-summary-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .memory-status-grid {
    grid-template-columns: 1fr;
  }

  .memory-record-top {
    flex-direction: column;
  }

  .memory-status-mono {
    max-width: 68%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .assistant-reply-gradient {
    animation: none;
    background-position: 50% 50%;
  }
}

/* ===== 任务管理页面 ===== */
.tasks-page {
  max-width: 980px;
}

.tasks-page-header {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: flex-start;
  margin-bottom: 1.25rem;
}

.tasks-page h1 {
  margin-bottom: 0.35rem;
}

.tasks-page-subtitle {
  margin: 0;
  color: rgba(255, 255, 255, 0.68);
  font-size: 0.95rem;
  line-height: 1.5;
}

.tasks-page-meta {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.tasks-filter-bar {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 1.25rem;
  padding: 0;
}

.tasks-filter-btn {
  padding: 0.4rem 1rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.88rem;
  cursor: pointer;
  transition: all 0.15s;
  font-family: inherit;
}

.tasks-filter-btn:hover {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.9);
}

.tasks-filter-btn.active {
  background: rgba(139, 92, 246, 0.2);
  border-color: rgba(139, 92, 246, 0.5);
  color: #fff;
}

.tasks-count {
  font-weight: 400;
  font-size: 0.9rem;
  opacity: 0.6;
}

.tasks-list {
  display: grid;
  gap: 0.75rem;
}

.task-card {
  padding: 1rem 1.2rem;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  transition: border-color 0.15s;
}

.task-card:hover {
  border-color: rgba(255, 255, 255, 0.15);
}

.task-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.task-card-info {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
  min-width: 0;
}

.task-title {
  font-weight: 600;
  font-size: 1rem;
  color: rgba(255, 255, 255, 0.95);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-type-badge,
.task-status-badge {
  padding: 0.2rem 0.55rem;
  border-radius: 999px;
  font-size: 0.78rem;
  border: 1px solid transparent;
  white-space: nowrap;
}

.task-card-actions {
  display: flex;
  gap: 0.5rem;
  flex-shrink: 0;
}

.task-action-btn {
  padding: 0.35rem 0.9rem;
  border-radius: 5px;
  font-size: 0.85rem;
  font-weight: 500;
  border: none;
  cursor: pointer;
  transition: all 0.15s;
  font-family: inherit;
}

.task-action-btn.cancel {
  background: rgba(239, 68, 68, 0.2);
  color: #fca5a5;
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.task-action-btn.cancel:hover:not(:disabled) {
  background: rgba(239, 68, 68, 0.35);
}

.task-action-btn.run {
  background: rgba(34, 197, 94, 0.2);
  color: #86efac;
  border: 1px solid rgba(34, 197, 94, 0.3);
}

.task-action-btn.run:hover:not(:disabled) {
  background: rgba(34, 197, 94, 0.35);
}

.task-action-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.task-card-detail {
  display: flex;
  gap: 1.2rem;
  flex-wrap: wrap;
  margin-top: 0.6rem;
  color: rgba(255, 255, 255, 0.52);
  font-size: 0.85rem;
}

.task-card-error {
  margin-top: 0.5rem;
  color: #fca5a5;
  font-size: 0.84rem;
  padding: 0.4rem 0.6rem;
  background: rgba(239, 68, 68, 0.1);
  border-radius: 4px;
}

@media (max-width: 900px) {
  .tasks-page-header {
    flex-direction: column;
  }

  .tasks-page-meta {
    justify-content: flex-start;
  }

  .task-card-top {
    flex-direction: column;
    align-items: flex-start;
  }

  .task-card-detail {
    flex-direction: column;
    gap: 0.3rem;
  }
}

/* ===== 聊天记录气泡视图（浅色） ===== */
.chat-flow{position:fixed;inset:0;z-index:200;background:#faf6f0;color:#3a322a;display:flex;flex-direction:column}
.chat-flow-header{display:flex;align-items:center;gap:12px;padding:12px 20px;background:#f2ebe2;border-bottom:1px solid #e6dbcd}
.chat-flow-avatar{width:36px;height:36px;border-radius:50%;background:#f6e3d0;border:1px solid #e0c3a4;color:#a9713c;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
.chat-flow-avatar.user{background:#ece2d6;border-color:#d8c8b6;color:#7d6a56}
img.chat-flow-avatar{display:block;object-fit:cover;background:#ffffff}
.chat-flow-title{display:flex;flex-direction:column;gap:2px}
.chat-flow-name{color:#4a3f36;font-size:17px;font-weight:700}
.chat-flow-status{color:#9b8b7c;font-size:12px}
.chat-flow-close{margin-left:auto;border:0;background:transparent;color:#9b8b7c;font-size:22px;cursor:pointer;padding:4px 8px}
.chat-flow-close:hover{color:#4a3f36}
.chat-flow-stream{flex:1;overflow-y:auto;padding:18px 22px;display:flex;flex-direction:column;gap:14px;max-width:900px;width:100%;margin:0 auto;background:#fdfbf8}
.chat-flow-row{display:flex;gap:10px;align-items:flex-start}
.chat-flow-row.user{justify-content:flex-end}
.chat-flow-body{display:flex;flex-direction:column;gap:4px;min-width:0;max-width:76%}
.chat-flow-sender{font-size:14px;color:#b07d4a;font-weight:700}
.chat-flow-bubble{font-size:15px;line-height:1.75;padding:10px 14px;border-radius:6px 14px 14px 14px;background:#ffffff;border:1px solid #ece0d2;color:#3a322a;white-space:pre-wrap;word-break:break-word}
.chat-flow-row.user .chat-flow-bubble{background:#e8b48c;border-color:#dfa878;color:#2a1a10;border-radius:14px 6px 14px 14px}
.chat-flow-bubble.pending{color:#9b8b7c;font-style:italic}
.chat-flow-attachment{display:inline-block;margin:2px 6px 2px 0;font-size:11px;color:#8a7a6d;border:1px dashed #ddcbb6;border-radius:4px;padding:1px 6px}
.chat-flow-row.user .chat-flow-attachment{color:#6d4a2c;border-color:#c9a077}
.chat-flow-empty{margin:auto;color:#9b8b7c;font-size:14px}
.chat-flow-footer{text-align:center;font-size:12px;color:#a3948a;padding:8px 0 12px;background:#fdfbf8}

/* ===== 气泡视图内的近一周会话切换（浅色） ===== */
.chat-flow-switcher-wrap{position:relative;margin-left:auto}
.chat-flow-switcher-toggle{border:1px solid #dfcdb8;background:#ffffff;color:#7d6a56;font-size:12px;padding:5px 12px;border-radius:999px;cursor:pointer;font-family:inherit}
.chat-flow-switcher-toggle:hover{background:#f7efe5;color:#5a4f45;border-color:#cbb69c}
.chat-flow-switcher{position:absolute;top:calc(100% + 8px);right:0;width:280px;max-height:360px;overflow-y:auto;background:#ffffff;border:1px solid #e6dbcd;border-radius:10px;padding:6px;display:flex;flex-direction:column;gap:4px;z-index:10}
.chat-flow-switcher-hint{font-size:12px;color:#9b8b7c;padding:10px 8px;text-align:center}
.chat-flow-switcher-hint.error{color:#c0524a}
.chat-flow-switcher-item{display:flex;flex-direction:column;gap:3px;border:0;background:transparent;text-align:left;padding:9px 10px;border-radius:8px;cursor:pointer;font-family:inherit}
.chat-flow-switcher-item:hover{background:#f7efe5}
.chat-flow-switcher-item.active{background:#f2e3d3;cursor:default}
.chat-flow-switcher-title{color:#4a3f36;font-size:13px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chat-flow-switcher-time{color:#a3948a;font-size:11px}
