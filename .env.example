# ============================================================
#  环境变量模板
# ============================================================
# 用法：
#   1. 复制成 .env：  copy .env.example .env   （macOS/Linux: cp .env.example .env）
#   2. 只在 .env 里填真实值。.env 已被 .gitignore 忽略，不会进版本库。
#   3. 全部为「懒检查」：不配也能启动，用到哪个功能时才提示缺哪个变量。
#
# 下面每个变量的「必填」栏含义：
#   [必填]  不配则该功能不可用
#   [可选]  不配会自动降级或禁用，不影响主程序
# ============================================================


# ---------- 对话模型（OpenAI 兼容接口）[必填] ----------
# 发消息时才检查，不配也能启动进程。
GEMINI_API_KEY=
# 网关地址，示例：https://jizhiapi.site/v1
GOOGLE_GEMINI_BASE_URL=
# 建议选不思考的型号，避免回复里带出思考链
GEMINI_MODEL=gemini-3.7-flash


# ---------- 聊天人设 [可选] ----------
# 不配则使用默认人设
# AGENT_SYSTEM_PROMPT=你是一个傲娇助手


# ---------- 记忆向量嵌入（智谱 BigModel）[必填] ----------
# 维度必须与 Qdrant 集合一致，默认 2048
ZHIPUAI_API_KEY=
ZHIPUAI_EMBEDDING_MODEL=embedding-3
ZHIPUAI_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPUAI_EMBEDDING_DIMENSIONS=2048


# ---------- 联网搜索 [可选] ----------
# 不配则 web_search 工具自动禁用，不影响主程序
BOCHA_API_KEY=
BOCHA_BASE_URL=
# Bing RSS 默认开启，与博查并行检索；设为 false 可关闭
BING_RSS_ENABLED=true
# 搜索闸门（控制一轮最多查几次、读几次）
SEARCH_GATE_ENABLED=true
SEARCH_GATE_MAX_QUERIES=3
SEARCH_GATE_MAX_READS=3


# ---------- 记忆提炼与维护 [可选] ----------
# 不配则记忆只做基础保存，不做语义提炼/定期维护
MEMORY_EXTRACT_ENABLED=true
MEMORY_MAINTENANCE_ENABLED=true
EXTRACT_BASE_URL=
EXTRACT_API_KEY=
EXTRACT_MODEL=


# ---------- 双端同步（本地 ↔ 云端）[可选] ----------
MEMORY_CLOUD_SYNC_ENABLED=false
CLOUD_MEMORY_URL=
CLOUD_MEMORY_TOKEN=
MEMORY_SYNC_INTERVAL_SECONDS=300
MEMORY_SYNC_SHUTDOWN_GRACE_SECONDS=10


# ---------- 情绪标注 [可选] ----------
EMOTION_TAGGER_API_BASE=
EMOTION_TAGGER_API_KEY=
EMOTION_TAGGER_MODEL=


# ---------- 其他模型后端 [可选] ----------
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_API_MODEL=
DEEPSEEK_API_KEY=
AMAP_WEB_SERVICE_KEY=


# ---------- 语音（TTS）[可选] ----------
# 不配则语音功能关闭
GPT_SOVITS_URL=
TTS_REF_AUDIO=
TTS_REF_TEXT=


# ---------- 多入口身份（CLI 本地模拟）[可选] ----------
# 生产入口必须由认证层注入账号身份，不从用户文本推断。
AGENT_ACCOUNT_ID=
AGENT_CHANNEL=
AGENT_CONVERSATION_ID=
AGENT_DELIVERY_TARGET=unified


# ---------- 代码代理（本地沙箱）[可选] ----------
# 路径类配置留空则使用默认值
CODE_AGENT_ENABLED=false
CODE_AGENT_RUNTIME_ROOT=
CODE_AGENT_SANDBOX_STATE_ROOT=
CODE_AGENT_SNAPSHOT_ROOT=
CODE_AGENT_ARTIFACT_DIR=
CODE_AGENT_APPLY_STATE_ROOT=
CODE_AGENT_PYTHON=
CODE_AGENT_POWERSHELL=
CODE_AGENT_AUTO_APPLY_LOW_RISK=false


# ---------- 路由与旧版影子模式 [可选] ----------
AGENT_ROUTING_MODE=
AGENT_HARNESS_ENABLED=false
AGENT_LEGACY_SHADOW_ENABLED=false
AGENT_REACH_COMMAND=
BILI_COMMAND=
